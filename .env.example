# AMMU BIRTHDAY WEBSITE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development: cp .env.example .env
# Never commit actual passwords, secret keys or tokens.

NODE_ENV=development
APP_BASE_URL=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata

BIRTHDAY_UNLOCK_AT=2026-11-17T00:00:00+05:30
CELEBRATION_URL=https://ammu-birthday-celebration-three.vercel.app
CELEBRATION_ALLOWED_ORIGIN=https://ammu-birthday-celebration-three.vercel.app

# Database configuration (Supabase Postgres)
# Leave blank to use durable local JSON storage (data/db.json) with development warning
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin Authentication & Sessions
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_PASSWORD=
SESSION_SECRET=
PREVIEW_ENABLED=true
PREVIEW_CODE=

# Resend Email Integration
RESEND_API_KEY=
RESEND_FROM_EMAIL=
AMMU_RECIPIENT_EMAIL=
ASHU_NOTIFICATION_EMAIL=
ASHU_EMAIL=
AMMU_EMAIL=

# Countdown Email System
COUNTDOWN_EMAILS_ENABLED=false
EMAIL_SCHEDULER_SECRET=
EMAIL_DEFAULT_TIMEZONE=Asia/Kolkata
EMAIL_DRY_RUN=true

# Live Shared Moment with Ashu
LIVE_SHARING_ENABLED=true

# Server Networking
PORT=4173
HOST=127.0.0.1
COOKIE_SECURE=0
DEMO_MODE=0
