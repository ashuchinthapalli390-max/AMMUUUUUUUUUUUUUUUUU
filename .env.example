# ==============================================================================
# AMMU BIRTHDAY WEBSITE — PRODUCTION RELEASE ENVIRONMENT CONFIGURATION
# Copy to .env for deployment / local run: cp .env.example .env
# Never commit actual passwords, secret keys, or private API credentials.
# ==============================================================================

# 1. Application Runtime
NODE_ENV=production
APP_BASE_URL=https://ammu-birthday.vercel.app
APP_TIMEZONE=Asia/Kolkata
BIRTHDAY_UNLOCK_AT=2026-11-17T00:00:00+05:30

# 2. Database Configuration (Supabase Postgres or Durable Local DB)
# In production on serverless, set DATABASE_URL or SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY.
# On standalone node server, falls back gracefully to data/db.json.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 3. Admin Authentication & Session Security
# Provide a strong admin password and session signing secret.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
COOKIE_SECURE=1

# 4. Resend Official Email Service Integration
RESEND_API_KEY=
RESEND_FROM_EMAIL=
AMMU_RECIPIENT_EMAIL=
ASHU_NOTIFICATION_EMAIL=

# 5. Countdown Email System (Production Scheduler & Dry-Run Mode)
# Set COUNTDOWN_EMAILS_ENABLED=true to activate background milestone delivery.
# Set EMAIL_DRY_RUN=false for real deliveries to Ammu; EMAIL_DRY_RUN=true simulates sending.
COUNTDOWN_EMAILS_ENABLED=false
EMAIL_DRY_RUN=true
EMAIL_SCHEDULER_SECRET=
RESEND_WEBHOOK_SECRET=

# 6. External 3D Birthday Celebration Integration
CELEBRATION_URL=https://ammu-birthday-celebration-three.vercel.app
CELEBRATION_ALLOWED_ORIGIN=https://ammu-birthday-celebration-three.vercel.app

# 7. Live Shared Realtime Experience
LIVE_SHARING_ENABLED=true

# 8. Server Network Binding
PORT=4173
HOST=0.0.0.0
